# ══════════════════════════════════════════════════════
# IT Inventory System — Production Environment Variables
# ══════════════════════════════════════════════════════
# DİKKAT: Bu dosya örnek (template) dosyadır. 
# Kendi sisteminize kurarken adını .env olarak değiştirin ve bilgileri doldurun.

# Flask Application
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET=your_jwt_secret_key_here
FLASK_ENV=production

# SQL Server Database
DB_SERVER=.\SQLEXPRESS
DB_NAME=IT_INVENTORY
DB_USER=your_db_username
DB_PASS=your_db_password
DB_PATH=database/inventory.db

# KeyOS MGT Credentials (Sadece okuma yetkisi olan bot hesabı)
KEYOS_USER=your_keyos_username
KEYOS_PASS=your_keyos_password
KEYOS_URL=https://keyosmgt.example.com

# Admin Access
ADMIN_USER=admin
ADMIN_PASS=your_admin_password

# SFTP Deployment
SFTP_HOST=192.168.x.x
SFTP_PORT=2205
SFTP_USER=your_sftp_user
SFTP_PASS=your_sftp_password
SFTP_REMOTE_BASE=C:/WebApps/IT_Inventory_System

ENCRYPTION_KEY=your_base64_encryption_key_here
