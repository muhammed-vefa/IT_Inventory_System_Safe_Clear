# ══════════════════════════════════════════════════════
# IT Inventory System — Environment Variables Example
# ══════════════════════════════════════════════════════
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Flask Application
SECRET_KEY=
JWT_SECRET=
FLASK_ENV=production

# SQL Server Database
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASS=
DB_PATH=

# KeyOS MGT Credentials
KEYOS_USER=
KEYOS_PASS=
KEYOS_URL=https://keyosmgt.kocaelish.com

# Admin Access
ADMIN_USER=
ADMIN_PASS=
