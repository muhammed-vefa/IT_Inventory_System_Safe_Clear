# IT Inventory System - Hastane Konfigürasyon Dosyası
# Bu dosyayı farklı bir hastane için .env olarak kaydedin ve düzenleyin.
# Eğer .env dosyası yoksa veya ayarlar eksikse sistem varsayılan olarak "Kocaeli Şehir Hastanesi" (kocaelish.com) ayarlarını kullanır.

# ================================
# GENEL HASTANE AYARLARI
# ================================
HOSPITAL_NAME="Kocaeli Şehir Hastanesi"
HOSPITAL_DOMAIN="kocaelish.com"

# ================================
# DIŞ SERVİS VE HIZLI LİNKLER
# ================================
# Sol menüdeki linkler için alt alan adları veya tam URL'ler.
# Eğer boş bırakılırsa varsayılan olarak {SERVIS}.{HOSPITAL_DOMAIN} kuralı uygulanır.
LINK_BIM="http://bim.kocaelish.com/"
